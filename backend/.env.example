# --- AI assistant -----------------------------------------------------------
# Provide ONE of these. With neither, the assistant runs in offline mode,
# which is fully functional (fuzzy search) and never breaks the demo.
#
# OpenAI (e.g. gpt-4o-mini):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
#
# Anthropic (e.g. claude-haiku-5-5):
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
#
# Force a provider: "auto" (default), "openai", "anthropic" or "offline".
AI_PROVIDER=auto

# --- Store ------------------------------------------------------------------
DATABASE_URL=sqlite:///./smartbasket.db
STORE_NAME=Smart Market
ADMIN_PIN=
